# Copy to .env and fill in from Supabase (Project Settings -> API). Public values, baked into the app;
# access control is Postgres RLS, not secrecy.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Map tiles for the live map. Use a keyed provider before go-live (spec decision D4).
# EXPO_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# EXPO_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors

# Optional crash reporting (src/sentry.ts).
# EXPO_PUBLIC_SENTRY_DSN=
